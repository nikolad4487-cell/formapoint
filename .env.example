# Neobvezni override zadane javne konfiguracije projekta.
# Postavite URL i javni ključ zajedno; nikad service_role ili Stripe tajni ključ.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa za starije Supabase projekte: VITE_SUPABASE_ANON_KEY
# Tajne se postavljaju isključivo u Supabase Edge Function Secrets:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, APP_URL
# RESEND_API_KEY, EMAIL_FROM, CRON_SECRET (neobvezno slanje obavijesti)

# Za namjerni offline način ili izolirane javne testove:
# VITE_SUPABASE_DISABLED=true
