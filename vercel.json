{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/seo.mjs": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/seo?__seo_path=/"
    },
    {
      "src": "/index.html",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/seo?__seo_path=/$1"
    }
  ]
}
